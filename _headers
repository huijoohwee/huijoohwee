/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-DNS-Prefetch-Control: off
  X-Permitted-Cross-Domain-Policies: none
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), clipboard-read=(), clipboard-write=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), xr-spatial-tracking=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  # NOTE: Do NOT set a global CSP here.
  # Cloudflare Pages will emit multiple Content-Security-Policy headers when both `/*`
  # and a more specific path define CSP. Browsers enforce the intersection, which can
  # silently break Singabldr (and Safari) by blocking scripts.
  # Set CSP only on the specific app paths below.

/content/singabldr/*
  # Strict CSP: no inline scripts. Singabldr boot logic is externalized to ./assets/boot.js.
  # Stricter: disallow all WebSockets (multiplayer disabled in production).
  # NOTE: This CSP intentionally forbids inline scripts. If Cloudflare features inject inline snippets
  # (e.g. Zaraz), disable them for this Pages project rather than weakening CSP.
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; img-src 'self' data: blob: https:; font-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' https://static.cloudflareinsights.com; script-src-attr 'none'; connect-src 'self' https://static.cloudflareinsights.com; frame-src 'self' https: data: blob:; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests; block-all-mixed-content

/singabldr/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; img-src 'self' data: blob: https:; font-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' https://static.cloudflareinsights.com; script-src-attr 'none'; connect-src 'self' https://static.cloudflareinsights.com; frame-src 'self' https: data: blob:; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests; block-all-mixed-content

# GameXR keeps motion, camera, XR, framing, and executable-content authority scoped to its public path.
# Inline element styles are required by the touch joystick; inline scripts remain forbidden.
/gamexr/*
  ! X-Frame-Options
  X-Frame-Options: SAMEORIGIN
  ! Permissions-Policy
  Permissions-Policy: accelerometer=(self), autoplay=(self), camera=(self), clipboard-read=(), clipboard-write=(), display-capture=(), geolocation=(), gyroscope=(self), magnetometer=(self), microphone=(), payment=(), usb=(), xr-spatial-tracking=(self)
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'none'; script-src 'self'; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; worker-src 'self'; manifest-src 'self'
  ! Referrer-Policy
  Referrer-Policy: no-referrer
  ! X-Content-Type-Options
  X-Content-Type-Options: nosniff

# `public, no-transform` blocks zone-level response transformation; Pages Web Analytics must
# also remain disabled because its project-level HTML injection precedes these response headers.
# `no-store` remains authoritative and forbids HTTP-cache storage of mutable release bytes.
