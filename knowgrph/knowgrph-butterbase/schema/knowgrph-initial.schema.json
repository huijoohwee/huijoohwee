{
  "tables": {
    "graph_nodes": {
      "columns": {
        "id": {
          "type": "uuid",
          "primaryKey": true,
          "default": "gen_random_uuid()"
        },
        "slug": {
          "type": "text"
        },
        "title": {
          "type": "text"
        },
        "kind": {
          "type": "text"
        },
        "summary": {
          "type": "text"
        },
        "tags": {
          "type": "jsonb",
          "default": "'[]'::jsonb"
        },
        "metadata": {
          "type": "jsonb",
          "default": "'{}'::jsonb"
        },
        "source_url": {
          "type": "text"
        },
        "created_at": {
          "type": "timestamptz",
          "default": "now()"
        },
        "updated_at": {
          "type": "timestamptz",
          "default": "now()"
        }
      }
    }
  }
}
